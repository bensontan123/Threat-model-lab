const { chromium } = require('playwright');
const http = require('http'), fs = require('fs'), path = require('path');
const root = '/home/user/threat-model-lab';
const mt = { '.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json' };
const srv = http.createServer((q, r) => { let f = path.join(root, decodeURIComponent(q.url.split('?')[0])); if (q.url==='/') f=path.join(root,'index.html'); if (!f.startsWith(root)||!fs.existsSync(f)||fs.statSync(f).isDirectory()){r.writeHead(404);return r.end();} r.writeHead(200,{'content-type':mt[path.extname(f)]||'text/plain'}); r.end(fs.readFileSync(f)); });
(async () => {
  await new Promise(ok => srv.listen(8811, ok));
  const b = await chromium.launch();
  const p = await b.newPage({ viewport: { width: 1320, height: 1100 } });
  const errs=[]; p.on('pageerror',e=>errs.push(e.message)); p.on('console',m=>{if(m.type()==='error')errs.push('c:'+m.text());});
  await p.route(/fonts\.g/, r => r.abort());
  await p.goto('http://localhost:8811/'); await p.waitForTimeout(1200);
  // IT sample -> canvas + kpis
  await p.click('#tmSample'); await p.waitForTimeout(400);
  const o = {};
  o.kpis = await p.locator('#tmStats .kpi').count();
  o.kpiLabels = await p.locator('#tmStats .kpi-l').allTextContents();
  o.kpiNums = await p.locator('#tmStats .kpi-n').allTextContents();
  o.canvasShown = !(await p.locator('#tmCanvasCard').isHidden());
  o.nodes = await p.locator('#tmCanvas .cnode').count();
  o.edges = await p.locator('#tmCanvas .cedge').count();
  o.paletteBtns = await p.locator('#tmPalette .pal').count();
  o.status = await p.textContent('#status');
  // palette click sets select + name focus
  await p.locator('#tmPalette .pal[data-type="datastore"]').click();
  o.selAfterPalette = await p.inputValue('#tmType');
  await p.screenshot({ path: '/tmp/claude-0/-home-user/8c2a26dd-ee13-54d7-a8e2-b5d2ebf18182/scratchpad/pro-it.png', fullPage:false });
  // OT canvas (Purdue layers)
  await p.click('[data-mode="ot-stride"]'); await p.waitForTimeout(200); await p.click('#tmSample'); await p.waitForTimeout(400);
  o.otNodes = await p.locator('#tmCanvas .cnode').count();
  o.otBands = await p.locator('#tmCanvas .cband-lbl').count();
  o.otEdges = await p.locator('#tmCanvas .cedge').count();
  await p.evaluate(()=>document.getElementById('tmCanvasCard').scrollIntoView());
  await p.screenshot({ path: '/tmp/claude-0/-home-user/8c2a26dd-ee13-54d7-a8e2-b5d2ebf18182/scratchpad/pro-ot.png', fullPage:false });
  // rapids: scenarios kpi
  await p.click('[data-mode="it-rapids"]'); await p.waitForTimeout(300);
  o.rapidsKpis = await p.locator('#tmStats .kpi-l').allTextContents();
  o.overflow = await p.evaluate(()=>document.documentElement.scrollWidth>innerWidth);
  console.log(JSON.stringify(o,null,1));
  console.log('errors', errs);
  await b.close(); srv.close();
})();
EOF
